{
  "runtime": "canvas-native-v1",
  "name": "Music Player",
  "description": "Control the music already playing on Windows, with four distinct layouts, adjustable backgrounds and a real optional audio spectrum.",
  "version": "1.1.1",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "auto"
  },
  "native": {
    "companion": {
      "runtime": "process-v2",
      "entries": {
        "windows-x86_64": "native/out/windows-x86_64/bin/backend.exe"
      }
    }
  },
  "settings": [
    {
      "id": "appearance",
      "type": "section",
      "label": "Appearance"
    },
    {
      "id": "layout",
      "type": "select",
      "label": "Layout",
      "scope": "layer",
      "default": "minimal",
      "options": [
        {
          "label": "Minimal",
          "value": "minimal"
        },
        {
          "label": "Artwork + spectrum",
          "value": "visualizer"
        },
        {
          "label": "Full artwork",
          "value": "artwork"
        },
        {
          "label": "Compact bar",
          "value": "compact"
        }
      ]
    },
    {
      "label": "Background",
      "scope": "layer",
      "id": "background",
      "default": "transparent",
      "type": "select",
      "options": [
        {
          "label": "Transparent",
          "value": "transparent"
        },
        {
          "label": "Solid color",
          "value": "color"
        },
        {
          "label": "Track artwork",
          "value": "artwork"
        }
      ]
    },
    {
      "label": "Background color",
      "scope": "layer",
      "showIf": {
        "setting": "background",
        "equals": "color"
      },
      "id": "backgroundColor",
      "default": "#121214",
      "type": "color"
    },
    {
      "scope": "layer",
      "id": "foreground",
      "type": "color",
      "label": "Text and icons",
      "default": "#ffffff"
    },
    {
      "max": 1,
      "label": "Border opacity",
      "id": "borderOpacity",
      "type": "range",
      "scope": "layer",
      "step": 0.05,
      "default": 0,
      "min": 0
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "scope": "layer",
      "default": "#ffffff"
    },
    {
      "id": "opacity",
      "type": "range",
      "label": "Background opacity",
      "scope": "layer",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.65,
      "description": "Applies only to the background; text and controls stay opaque."
    },
    {
      "id": "blur",
      "type": "range",
      "label": "Background blur",
      "scope": "layer",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "id": "showAlbum",
      "type": "boolean",
      "label": "Album name",
      "scope": "layer",
      "default": true
    },
    {
      "id": "showFavorite",
      "type": "boolean",
      "label": "Local favorites",
      "description": "Save track names on this device. Does not change favorites in Spotify or another player.",
      "scope": "layer",
      "default": true
    },
    {
      "id": "language",
      "type": "select",
      "label": "Language",
      "scope": "layer",
      "default": "auto",
      "options": [
        {
          "label": "Automatic",
          "value": "auto"
        },
        {
          "label": "English",
          "value": "en"
        },
        {
          "label": "Français",
          "value": "fr"
        }
      ]
    },
    {
      "id": "device",
      "type": "section",
      "label": "Device"
    },
    {
      "id": "favorites",
      "type": "textarea",
      "label": "Saved tracks",
      "description": "Local JSON list shared by the Music Player instances on this device.",
      "scope": "device",
      "default": "[]"
    }
  ],
  "presets": [
    {
      "id": "minimal",
      "name": "Minimal",
      "settings": {
        "layout": "minimal"
      }
    },
    {
      "id": "visualizer",
      "name": "Artwork + spectrum",
      "settings": {
        "layout": "visualizer"
      }
    },
    {
      "id": "artwork",
      "name": "Full artwork",
      "settings": {
        "layout": "artwork"
      }
    },
    {
      "id": "compact",
      "name": "Compact bar",
      "settings": {
        "layout": "compact"
      }
    }
  ]
}
